# Kopieren nach .env und anpassen

# Admin-Bereich: Anmeldung mit Discord für alle mit dieser Rolle auf dem Discord-Server
# (Name oder ID; Server-Inhaber und Administratoren immer). Braucht Bot und DISCORD_CLIENT_SECRET.
# Später in den Einstellungen änderbar.
ADMIN_DISCORD_ROLE=Orga
# Optionaler Notzugang mit Passwort (leer = nur Discord). Ohne Discord-Login wird sonst eins erzeugt.
ADMIN_PASSWORD=
# Port auf dem Host (optional, Standard 3000)
PORT=3000
# Standard: nur Loopback. Bei externem Proxy die konkrete Backend-IP setzen und Port per Firewall sperren.
BIND_ADDRESS=127.0.0.1

# Optional: Discord-Voice-Kanäle pro Turnier anlegen
# Bot-Token aus dem Discord Developer Portal und ID des Discord-Servers
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional: feste Textkanäle für Ansagen – allgemein (Durchsagen, Programm) und Turniere.
# Leer lassen: der Bot legt #lan-ansagen und #turnier-ansagen selbst an.
DISCORD_ANNOUNCE_CHANNEL_ID=
DISCORD_TOURNAMENT_CHANNEL_ID=
# Optional: Adresse der Seite für Links in Discord-Ansagen
PUBLIC_URL=

# Optional: Startwerte – danach im Admin-Bereich unter "Einstellungen" änderbar
EVENT_NAME=Seniorenlan
# OLA-Weboberfläche auf dem Raspberry Pi mit der DMX-Lampe
OLA_URL=
DMX_UNIVERSE=1
DMX_RED_CHANNEL=1
# Sekunden, die eine Durchsage (und die Lampe) aktiv bleibt; 0 = bis /announce_ende
DMX_RESET_SECONDS=60
# Nur Mitglieder dieser Discord-Rolle dürfen /announce nutzen (leer = alle)
ANNOUNCE_ROLE_NAME=

# Optional: "Mit Discord anmelden" für den Ticketverkauf.
# Developer Portal -> deine Anwendung -> OAuth2 -> Client Secret.
# Dort unter "Redirects" zusätzlich <PUBLIC_URL>/api/auth/callback eintragen.
DISCORD_CLIENT_SECRET=

# Läuft die Seite hinter einem Reverse Proxy (z. B. für HTTPS)? Dann 1 setzen.
# Zusätzlich die tatsächlichen Quell-IPs des Proxys zulassen; keine breiten LAN-/Docker-Netze eintragen.
TRUST_PROXY=
TRUSTED_PROXIES=
# 1: nur Proxy-Zugriffe; ausgenommen ist ausschließlich GET /api/health auf Container-Loopback.
PROXY_ONLY=0
