# LAN-Standort: TMT2 + LAN-Client (docker-compose.lan.yml). Kopieren nach .env.lan und ausfüllen.
# Öffentliche Adresse der LAN-Verwaltung (HTTPS)
LAN_URL=https://lan.example.org
# Dasselbe Token wie TMT2_AGENT_TOKEN in der LAN-Verwaltung (mindestens 32 Zeichen)
TMT2_AGENT_TOKEN=
# Globales TMT2-Token: nach dem ersten Start aus "docker logs tmt2" (First auto generated access token)
TMT2_TOKEN=
# TMT2 im LAN erreichbar machen (CS2-Server senden Logs), z. B. die LAN-IP dieses Rechners
TMT2_BIND_ADDRESS=127.0.0.1
TMT2_PORT=8080
# Adresse von TMT2 aus Sicht der CS2-Server, z. B. http://192.168.1.10:8080
TMT2_LOG_ADDRESS=
